{
  "_schema_version": 1,
  "_description": "RQ1 Original-only SNLI-2033 controls: unique size-matched and post-split token-matched against rq1_mr_snli_seed*_none.",
  "models": {
    "gemma-3-4b-it": {
      "hub_id": "google/gemma-3-4b-it",
      "local_path": "models/google/gemma-3-4b-it",
      "local_tokenizer_path": "models/google/gemma-3-4b-it",
      "template": "gemma",
      "cuda": "1",
      "training_data": {
        "snli_2033_gemma-3-4b-it": {
          "original": "data/nli/metTrain_original/snli_labeled_data.json",
          "target": 2033,
          "experiment_name_template": "rq1_original_snli_2033_gemma-3-4b-it_seed{seed}",
          "write_split_manifest": "data/ft_datasets/{name}/split_manifest.json",
          "_note": "2033 unique Original SNLI rows; no repetition."
        },
        "snli_2033_gemma-3-4b-it_tokenmatched": {
          "original": "data/nli/metTrain_original/snli_labeled_data.json",
          "target": 2033,
          "experiment_name_template": "rq1_original_snli_2033_gemma-3-4b-it_tokenmatched_seed{seed}",
          "split_manifest": "data/ft_datasets/rq1_original_snli_2033_gemma-3-4b-it_seed{seed}/split_manifest.json",
          "token_match": {
            "reference_train": "data/ft_datasets/rq1_mr_snli_seed{seed}_none/full_train.json",
            "reference_validation": "data/ft_datasets/rq1_mr_snli_seed{seed}_none/full_val.json",
            "expected_reference_tokens": {
              "train": {
                "42": 361482,
                "43": 360988,
                "44": 359753
              },
              "validation": {
                "42": 17814,
                "43": 18308,
                "44": 19543
              }
            },
            "tolerance": 32,
            "max_repeat": 4,
            "max_label_drift_pp": 1.0
          },
          "_note": "Same unique split as the standard control; repetition is applied independently after splitting."
        }
      }
    }
  },
  "test_sets": {
    "original": {
      "snli": "data/nli/original_dataset/snli/test.json",
      "mnlim": "data/nli/original_dataset/mnlim/test.json",
      "mnlimm": "data/nli/original_dataset/mnlimm/test.json",
      "sick": "data/nli/original_dataset/sick/test.json"
    },
    "mr": {
      "snli": "data/nli/MR_testing/snli_test_MR",
      "mnlim": "data/nli/MR_testing/mnlim_test_MR",
      "mnlimm": "data/nli/MR_testing/mnlimm_test_MR",
      "sick": "data/nli/MR_testing/sick_test_MR"
    }
  },
  "experiment_defaults": {
    "ft_params": {
      "lr": 0.0003,
      "epochs": 3.0,
      "rank": 8,
      "batch": 4,
      "grad_accum": 8
    },
    "task_type": "nli",
    "val_ratio": 0.05,
    "cutoff_len": 512,
    "eval_strategy": "no",
    "save_steps": 9999,
    "save_total_limit": 2,
    "test_batch_size": 32,
    "max_new_tokens": 10
  },
  "default_seeds": [
    42,
    43,
    44
  ],
  "default_train_datasets": [
    "snli_2033_gemma-3-4b-it",
    "snli_2033_gemma-3-4b-it_tokenmatched"
  ],
  "default_experiment_types": [
    "original"
  ],
  "default_mr_instruction_mode": "none",
  "default_test_mode": "merged"
}
