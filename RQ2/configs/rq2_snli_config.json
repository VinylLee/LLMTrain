{
  "_schema_version": 2,
  "_description": "RQ2 controlled SNLI MR-information grounding experiment (grounding-aware 2x2x2 design)",
  "_design": {
    "doc": "RQ2/RQ2_INSTRUCTION_DESIGN.md",
    "relation_audit": "RQ2/MR_RELATION_AUDIT.md",
    "factors": {
      "P": "pair / source-follow-up grounding",
      "O": "operation (input-transformation specification)",
      "R": "relation (output-relation specification)",
      "L": "source-label anchoring (diagnostic only, never part of the core 2x2x2)"
    },
    "core_modes": [
      "none",
      "operation_only",
      "relation_only",
      "operation_relation",
      "pair_only",
      "pair_operation",
      "pair_relation",
      "full_specification"
    ],
    "control_modes": [
      "pair_shuffled_operation",
      "pair_shuffled_relation"
    ],
    "diagnostic_modes": [
      "full_oracle"
    ],
    "_note": "P/O/R/L metadata is emitted by scripts/mr_instruction_design.py (shared registry) into conversion_report.json and experiment_meta.json; it is never re-derived from the mode name.",
    "_deprecated_aliases": {
      "relation_aware": "full_specification",
      "shuffled_operation": "pair_shuffled_operation"
    }
  },
  "instruction_template_version": 3,
  "_converted_dir_note": "v3 wording differs from the frozen v2 templates; the historical v2 conversions under RQ2/data/converted/ are left untouched.",
  "converted_dir": "RQ2/data/converted_v3",
  "model": {
    "key": "gemma-3-4b-it",
    "hub_id": "google/gemma-3-4b-it",
    "local_path": "models/google/gemma-3-4b-it",
    "template": "gemma",
    "cuda": "0"
  },
  "data": {
    "training_input": "data/nli/mettrain/snli_lr0.0037_gemma-3-4b-it-qat/augmented_data.json",
    "merged_test_input": "data/nli/mr_test_data_merged/snli.jsonl",
    "target_samples": 5340,
    "val_ratio": 0.05,
    "cutoff_len": 512
  },
  "modes": [
    "none",
    "operation_only",
    "relation_only",
    "operation_relation",
    "pair_only",
    "pair_operation",
    "pair_relation",
    "full_specification",
    "pair_shuffled_operation",
    "pair_shuffled_relation",
    "full_oracle"
  ],
  "seeds": [42, 43, 44],
  "training": {
    "learning_rate": 0.0003,
    "epochs": 3.0,
    "rank": 8,
    "batch": 4,
    "grad_accum": 8,
    "save_steps": 9999,
    "save_total_limit": 2,
    "test_batch_size": 32,
    "max_new_tokens": 10
  },
  "_output_root_note": "v3 block wording changed vs the frozen v2 templates, so this run writes to a fresh root. Historical v2 artifacts stay under RQ2/output/gemma3_4b_nli{,_full_seed42}/ and are NOT comparable.",
  "output_root": "RQ2/output/gemma3_4b_nli_grounded_v3",
  "data_root": "RQ2/data"
}
